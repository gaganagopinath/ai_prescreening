# Copy to .env on the server and provide your private provider key there.
GEMINI_API_KEY=replace-with-your-private-key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
JWT_SECRET=replace-with-a-long-random-secret
INITIAL_RECRUITER_EMAIL=admin@example.com
INITIAL_RECRUITER_PASSWORD=replace-with-a-strong-password
PORT=3001
